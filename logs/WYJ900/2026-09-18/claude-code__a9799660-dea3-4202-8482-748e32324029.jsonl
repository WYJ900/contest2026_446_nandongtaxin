{"schema_version": "1.0", "session_id": "a9799660-dea3-4202-8482-748e32324029", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 49, "ts": "2026-09-12T04:15:06.990Z", "role": "tool", "tool_name": "<result>", "tool_call_id": "toolu_0166DPwYZmoqNehSzWmpAybo", "input": null, "output": "1\t\"\"\"问2：两阶段随机决策（日前分位数报量 + 实时 LP 纠偏）\n2\t\n3\t结构（两个阶段都是 LP，见 LOG 第四节坑二：实时阶段绝不能用贪心）\n4\t------------------------------------------------------------------\n5\t阶段一（每天 0:00，信息集 = 日历 + 附件1 电价 + d 日之前的附件2 历史）：\n6\t    以净负荷的 tau 分位数曲线为约束右端，求计划购电量 q_plan 并锁定。\n7\t        min  sum_k pi_k q_k  - lam * S_144\n8\t        s.t. q_k + d_k - c_k >= nethat_k(tau)\n9\t             SOC 递推、区间、功率上限\n10\t阶段二（实时结算，用附件2 真值；q_plan 是常数不是变量）：\n11\t        min  sum_k 5 pi_k qem_k  - lam * S_144\n12\t        s.t. q_plan_k + qem_k + d_k - c_k >= net_k(真值)\n13\t             SOC 递推（从当日初值 S_0 连续递推）、区间、功率上限\n14\t    输出的 S_144 成为次日 S_0，形成全年一条连续 SOC 链。\n15\t\n16\t日边界 SOC 的处置（LOG 未定，本文件的建模决策）\n17\t------------------------------------------------------------------\n18\t不能强制 S_144 = S_0：实时阶段为把储能补回参考值，可能被迫付 5 倍紧急购电。\n19\t也不能让 S_144 自由：每天都会放空到 1200，次日从空起步。\n20\t故给终端存量一个「水价」lam（元/kWh），把跨日耦合线性化为终端奖励项。\n21\tlam 由典型日稳态循环 LP 的终端对偶价实测得到（recon_q2.py）：lam* ≈ 0.472，\n22\t介于 min(pi)/eta_c = 0.4126 与 夜间均价/eta_c = 0.4815 之间。\n23\tlam 只影响日边界处的存量偏好，不改变日内套利结构；且两阶段用同一 lam\n24\t保证日前与实时对存量的估值一致（否则实时会系统性偏离日前意图）。\n25\t\n26\t日前曲线（recon_q2f.py 选型，校准已验证）\n27\t------------------------------------------------------------------\n28\t    nethat_k(tau) = load[d-7]_k - mean(pv[d-7..d-1])_k\n29\t                    + Q_tau({net - nethat : 过去 60 天, 同 slot})\n30\t负载用「上周同一天」：日负载 89.3% 方差由星期解释（周五/周六 78k，其余 124k，\n31\t104 天零例外），MAE 仅 1635 kWh (0.4%)。光伏用近 7 天均值，MAE 2227 kWh。\n32\t残差分位数使 tau 有明确校准含义：tau=0.8 -> 逐 slot 覆盖 0.780。\n33\t信息集只含 d 日之前的数据与日历，无未来信息泄露。\n34\t\"\"\"\n35\tfrom __future__ import annotations\n36\t\n37\timport datetime as _dt\n38\tfrom dataclasses import dataclass, field\n39\t\n40\timport numpy as np\n41\tfrom scipy.optimize import linprog\n42\tfrom scipy.sparse import csr_matrix, hstack, eye\n43\t\n44\timport data_loader as D\n45\t\n46\tN = D.N_SLOT\n47\tDT = D.DT_H\n48\tE_MAX = D.E_ESS_MAX               # 833.33 kWh 单 slot 充/放上限\n49\tETA_C, ETA_D = 0.90, 0.90         # 主口径：双侧 90%（往返 0.81）\n50\tLAM_STAR = 0.472                  # 元/kWh，终端存量水价（recon_q2.py 实测）\n51\tEM_MULT = 5.0                     # 紧急购电电价倍数\n52\tRESID_WIN = 60                    # 残差分位数窗口（天）\n53\tPV_MA = 7                         # 光伏点预测的滚动均值天数\n54\tRT_STEP = 6                       # 实时 MPC 重优化步长（6 slot = 1 小时）\n55\t\n56\t\n57\t# ================================================================ 日前曲线\n58\t\n59\tclass Forecaster:\n60\t    \"\"\"严格因果的日前净负荷分位数曲线生成器。\n61\t\n62\t    只使用 d 日之前的附件2 数据与日历信息。\n63\t    \"\"\"\n64\t\n65\t    def __init__(self, ds: D.Dataset):\n66\t        self.ds = ds\n67\t        self.load_e = ds.load * DT                    # (365,144) kWh\n68\t        self.pv_e = ds.pv * DT\n69\t        self.net = self.load_e - self.pv_e\n70\t        n = len(ds.dates)\n71\t        self.net_hat = np.full((n, 144), np.nan)\n72\t        for i in range(7, n):                         # i<7 无「上周同一天」\n73\t            self.net_hat[i] = (self.load_e[i - 7]\n74\t                               - self.pv_e[i - PV_MA:i].mean(0))\n75\t\n76\t    def point(self, i: int) -> np.ndarray:\n77\t        \"\"\"点预测（tau=0.5 的基准）。i<7 时退化为附件1 期望曲线。\"\"\"\n78\t        if i < 7:\n79\t            return (self.ds.typical.load - self.ds.typical.pv) * DT\n80\t        return self.net_hat[i]\n81\t\n82\t    def curve(self, i: int, tau: float) -> np.ndarray:\n83\t        \"\"\"净负荷的 tau 分位数曲线（kWh/slot）。\"\"\"\n84\t        base = self.point(i)\n85\t        lo = max(7, i - RESID_WIN)\n86\t        if i - lo < 10:                               # 残差样本不足，退化为点预测\n87\t            return base\n88\t        hr = self.net[lo:i] - self.net_hat[lo:i]      # (m,144) 严格过去的残差\n89\t        return base + np.quantile(hr, tau, axis=0)\n90\t\n91\t\n92\t# ================================================================ LP 构件\n93\t\n94\tdef _soc_blocks(n_extra: int):\n95\t    \"\"\"SOC 递推等式的系数块：S_k - S_{k-1} - eta_c*c_k + d_k/eta_d = 0。\n96\t\n97\t    变量顺序 [其他(n_extra*N) | c(N) | d(N) | S(N)]。\n98\t    \"\"\"\n99\t    I = eye(N, format=\"csr\")\n100\t    Dm = eye(N, format=\"csr\") - eye(N, k=-1, format=\"csr\")\n101\t    Z = csr_matrix((N, n_extra * N))\n102\t    return hstack([Z, -ETA_C * I, (1.0 / ETA_D) * I, Dm], format=\"csr\")\n103\t\n104\t\n105\tdef _solve(cvec, A_ub, b_ub, A_eq, b_eq, bounds):\n106\t    res = linprog(cvec, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq,\n107\t                  bounds=bounds, method=\"highs\")\n108\t    if not res.success:\n109\t        raise RuntimeError(res.message)\n110\t    return res\n111\t\n112\t\n113\tdef day_ahead(price: np.ndarray, net_hat: np.ndarray, soc0: float,\n114\t              lam: float = LAM_STAR) -> np.ndarray:\n115\t    \"\"\"阶段一：给定分位数净负荷曲线，求计划购电量 q_plan。\n116\t\n117\t    变量 [q(N) | c(N) | d(N) | S(N)]，目标 min sum pi*q - lam*S_144。\n118\t    \"\"\"\n119\t    I = eye(N, format=\"csr\")\n120\t    Z = csr_matrix((N, N))\n121\t\n122\t    A_eq = _soc_blocks(1)\n123\t    b_eq = np.zeros(N)\n124\t    b_eq[0] = soc0\n125\t\n126\t    # 供电约束：-q - d + c <= -net_hat\n127\t    A_ub = hstack([-I, I, -I, Z], format=\"csr\")\n128\t    b_ub = -net_hat\n129\t\n130\t    cvec = np.concatenate([price, np.zeros(N), np.zeros(N), np.zeros(N)])\n131\t    cvec[4 * N - 1] = -lam                            # 终端存量水价\n132\t\n133\t    bounds = ([(0.0, None)] * N + [(0.0, E_MAX)] * N\n134\t              + [(0.0, E_MAX)] * N + [(D.SOC_LO, D.SOC_HI)] * N)\n135\t\n136\t    res = _solve(cvec, A_ub, b_ub, A_eq, b_eq, bounds)\n137\t    return res.x[:N].copy()\n138\t\n139\t\n140\tdef _rt_window(price: np.ndarray, net: np.ndarray, q_plan: np.ndarray,\n141\t               soc0: float, lam: float) -> dict:\n142\t    \"\"\"实时窗口 LP（长度 m 可变），q_plan 为常数。\n143\t\n144\t    变量 [qem(m) | c(m) | d(m) | S(m)]，目标 min sum 5*pi*qem - lam*S_end。\n145\t    \"\"\"\n146\t    m = price.size\n147\t    I = eye(m, format=\"csr\")\n148\t    Z = csr_matrix((m, m))\n149\t    Dm = eye(m, format=\"csr\") - eye(m, k=-1, format=\"csr\")\n150\t\n151\t    A_eq = hstack([Z, -ETA_C * I, (1.0 / ETA_D) * I, Dm], format=\"csr\")\n152\t    b_eq = np.zeros(m)\n153\t    b_eq[0] = soc0\n154\t\n155\t    # 供电约束：q_plan + qem + d - c >= net  ->  -qem - d + c <= q_plan - net\n156\t    A_ub = hstack([-I, I, -I, Z], format=\"csr\")\n157\t    b_ub = q_plan - net\n158\t\n159\t    cvec = np.concatenate([EM_MULT * price, np.zeros(m),\n160\t                           np.zeros(m), np.zeros(m)])\n161\t    cvec[4 * m - 1] = -lam\n162\t\n163\t    bounds = ([(0.0, None)] * m + [(0.0, E_MAX)] * m\n164\t              + [(0.0, E_MAX)] * m + [(D.SOC_LO, D.SOC_HI)] * m)\n165\t\n166\t    res = _solve(cvec, A_ub, b_ub, A_eq, b_eq, bounds)\n167\t    return dict(qem=res.x[:m], c=res.x[m:2*m],\n168\t                d=res.x[2*m:3*m], S=res.x[3*m:])\n169\t\n170\t\n171\tdef real_time(price: np.ndarray, net_true: np.ndarray, q_plan: np.ndarray,\n172\t              soc0: float, lam: float = LAM_STAR,\n173\t              net_fc: np.ndarray | None = None,\n174\t              step: int = RT_STEP) -> dict:\n175\t    \"\"\"阶段二（因果 MPC）：逐时段执行，只用已实现信息 + 对未来的预测。\n176\t\n177\t    ★ 为何不能把整日真值一次性交给 LP（坑九，自审发现的最严重缺陷）\n178\t    ------------------------------------------------------------------\n179\t    题目要求「实时用附件2 真值**结算**」，但用真值**优化**储能充放等价于\n180\t    假设 0:00 已知全天每 10 分钟真值。初版如此实现，导致 93.4% 的紧急购电\n181\t    发生在储能仍有可放余量时，甚至出现 SOC=10800 满仓仍紧急购电（物理上\n182\t    讲不通，唯一解释是 LP 预知后面电价更高、故意留电）。\n183\t    2 月实测该乐观偏差为费用 +1.29%、紧急购电量 **6.5 倍**。\n184\t\n185\t    正确做法：计划量 0:00 锁定（题意如此），储能充放逐时段决策——\n186\t    在 slot k 只能用 net_true[0..k] 与对未来的预测。本函数每 step 个 slot\n187\t    （默认 6 = 1 小时）重优化一次：当前窗口用真值、其后用日前点预测 net_fc，\n188\t    只执行当前窗口的决策，再前进一格。\n189\t\n190\t    net_fc=None 时退化为「完美预见」，仅用于生成实时理想下界作对照。\n191\t    \"\"\"\n192\t    if net_fc is None:\n193\t        net_fc = net_true                        # 完美预见（对照用）\n194\t    soc = float(soc0)\n195\t    qem = np.zeros(N)\n196\t    c = np.zeros(N)\n197\t    d = np.zeros(N)\n198\t    S = np.zeros(N)\n199\t\n200\t    for k0 in range(0, N, step):\n201\t        m = N - k0\n202\t        ns = min(step, m)\n203\t        # 当前窗口用真值，其后用预测（这是因果性的体现）\n204\t        net_sub = np.empty(m)\n205\t        net_sub[:ns] = net_true[k0:k0 + ns]\n206\t        if m > ns:\n207\t            net_sub[ns:] = net_fc[k0 + ns:]\n208\t        sol = _rt_window(price[k0:], net_sub, q_plan[k0:], soc, lam)\n209\t        qem[k0:k0 + ns] = sol[\"qem\"][:ns]\n210\t        c[k0:k0 + ns] = sol[\"c\"][:ns]\n211\t        d[k0:k0 + ns] = sol[\"d\"][:ns]\n212\t        S[k0:k0 + ns] = sol[\"S\"][:ns]\n213\t        soc = float(sol[\"S\"][ns - 1])\n214\t\n215\t    # 兜底：因预测误差，已执行段可能在真值下略有缺口未被覆盖，\n216\t    # 用紧急购电补足（这正是紧急购电的物理含义：事后被动补缺）。\n217\t    supply = q_plan + qem + d - c\n218\t    short = np.maximum(net_true - supply, 0.0)\n219\t    if short.max() > 1e-9:\n220\t        qem = qem + short\n221\t    return dict(qem=qem, c=c, d=d, S=S)\n222\t\n223\t\n224\t# ================================================================ 全年滚动\n225\t\n226\t@dataclass\n227\tclass YearResult:\n228\t    dates: list = field(default_factory=list)\n229\t    q_plan: list = field(default_factory=list)\n230\t    q_em: list = field(default_factory=list)", "is_error": false}
