   590.2610   610.7198\n56\t2 2025-02-03  1422.0281  1415.6503  1158.0129   587.0526   592.1503\n57\t         日期\\时间  0:10-0:20  0:20-0:30  0:30-0:40  0:40-0:50  0:50-1:00\n58\t332 2025-12-30  1418.3425  1436.6728  1214.1808   611.7670   589.1883\n59\t333 2025-12-31  1476.0850  1487.5876  1238.5843   587.0796   589.5519\n60\t-- 充放电量 shape=(2004, 6) cols[:6]=['日期', '时间段', '充电量', '放电量', '时刻', '储电量'] cols[-3:]=['放电量', '时刻', '储电量']\n61\t          日期         时间段          充电量          放电量     时刻        储电量\n62\t0 2025-02-01   0:00-4:00  1863.850654     6.700609   0:00  8344.1625\n63\t1        NaT   4:00-8:00   764.000517  6628.931233  24:00  7990.5366\n64\t2        NaT  8:00-12:00  2581.248383   677.727283    NaN        NaN\n65\t      日期          时间段          充电量          放电量   时刻  储电量\n66\t2002 NaT  16:00-20:00   150.951856  5668.316393  NaN  NaN\n67\t2003 NaT  20:00-24:00  7420.101427  3043.203277  NaN  NaN\n68\t-- 紧急购电量 shape=(1824, 3) cols[:6]=['日期', '购电时间段', '购电量'] cols[-3:]=['日期', '购电时间段', '购电量']\n69\t          日期        购电时间段      购电量\n70\t0 2025-02-01  21:00-21:20  39.1211\n71\t1 2025-02-02    6:00-6:10   3.2212\n72\t2        NaT  10:40-10:50   6.2687\n73\t      日期        购电时间段      购电量\n74\t1822 NaT  10:40-10:50  27.9224\n75\t1823 NaT  21:00-21:30  83.5355", "is_error": false}
{"schema_version": "1.0", "session_id": "a9799660-dea3-4202-8482-748e32324029", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 36, "ts": "2026-09-12T04:13:09.696Z", "model": "claude-opus-5", "tokens_in": 2, "tokens_out": 3484, "role": "tool", "tool_name": "Bash", "tool_call_id": "toolu_01YXK7prfyUnAz2WMadwQz1Z", "input": {"command": "cd \"D:/desktop/C题\" && cat > _audit1.py <<'EOF'\n# -*- coding: utf-8 -*-\n\"\"\"独立审计脚本 #1：数据事实复核 + 问1 结果校验（不复用项目 data_loader）\"\"\"\nimport numpy as np, pandas as pd, sys, io\nsys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')\n\nA1 = pd.read_excel('附件/附件1.xlsx')\nprice1 = A1['电价'].to_numpy(float)          # 144\nload1  = A1['小区负载'].to_numpy(float)\npv1    = A1['光伏发电预测功率'].to_numpy(float)\n\nL = pd.read_excel('附件/附件2.xlsx', sheet_name='小区负载')\nP = pd.read_excel('附件/附件2.xlsx', sheet_name='光伏发电实际功率')\ndates = pd.to_datetime(L.iloc[:,0])\nload2 = L.iloc[:,1:].to_numpy(float)          # 365x144\npv2   = P.iloc[:,1:].to_numpy(float)\nA4 = pd.read_excel('附件/附件4.xlsx')\nprice4 = A4.iloc[:,1:].to_numpy(float)\n\nprint('== A. 数据事实复核 ==')\nprint('shapes', load2.shape, pv2.shape, price4.shape)\nprint('附件1电价 vs 附件4年均  max|dev| = %.3e' % np.abs(price1-price4.mean(0)).max())\nprint('附件1负载 vs 附件2年均  max|dev| = %.3e' % np.abs(load1-load2.mean(0)).max())\nprint('附件1光伏 vs 附件2年均  max|dev| = %.3e' % np.abs(pv1-pv2.mean(0)).max())\n\ndE_load = load2.sum(1)/6; dE_pv = pv2.sum(1)/6\nprint('日负载电量 mean %.1f min %.1f max %.1f' % (dE_load.mean(), dE_load.min(), dE_load.max()))\ndow = dates.dt.dayofweek.to_numpy()\nfor d in range(7):\n    m = dow==d\n    print('  周%d n=%3d 日负载均值 %10.1f  日光伏均值 %10.1f' % (d+1, m.sum(), dE_load[m].mean(), dE_pv[m].mean()))\nlowmask = dE_load < 100000\nprint('低负载日(<1e5) n=%d, 其 dow 分布 %s' % (lowmask.sum(), np.bincount(dow[lowmask], minlength=7)))\nprint('附件1日负载电量 %.1f, 在365天中经验分位 %.3f' % (load1.sum()/6, (dE_load < load1.sum()/6).mean()))\n\n# ---- 问1 独立 LP ----\nfrom scipy.optimize import linprog\ndef solve_q1(price, load, pv, eta_c=0.9, eta_d=0.9, soc0=6000.,\n             smin=1200., smax=10800., pmax=5000., dt=1/6, cyclic=True):\n    T=len(price)\n    # vars: g(T) 购电, ch(T), dis(T)  (kWh per slot)\n    n=3*T\n    c=np.concatenate([price*1.0, np.zeros(T), np.zeros(T)])\n    # 供需: g + pv*dt + dis - ch >= load*dt   ->  -g - dis + ch <= pv*dt - load*dt\n    A_ub=[]; b_ub=[]\n    I=np.eye(T); Z=np.zeros((T,T))\n    A_ub.append(np.hstack([-I, I, -I])); b_ub.append(pv*dt - load*dt)\n    # SOC 上下界: soc_k = soc0 + sum(eta_c*ch - dis/eta_d)\n    Lmat=np.tril(np.ones((T,T)))\n    Asoc=np.hstack([Z, eta_c*Lmat, -Lmat/eta_d])\n    A_ub.append(Asoc);  b_ub.append(np.full(T, smax-soc0))\n    A_ub.append(-Asoc); b_ub.append(np.full(T, soc0-smin))\n    A_ub=np.vstack(A_ub); b_ub=np.concatenate(b_ub)\n    A_eq=None; b_eq=None\n    if cyclic:\n        A_eq=np.hstack([np.zeros(T), eta_c*np.ones(T), -np.ones(T)/eta_d])[None,:]\n        b_eq=np.array([0.0])\n    bounds=[(0,None)]*T + [(0,pmax*dt)]*T + [(0,pmax*dt)]*T\n    r=linprog(c,A_ub,b_ub,A_eq,b_eq,bounds,method='highs')\n    return r\n\nprint('\\n== B. 问1 独立复算 ==')\nfor name,(ec,ed) in {'双侧90%':(0.9,0.9),'单侧90%(充)':(0.9,1.0),'往返90%':(np.sqrt(0.9),np.sqrt(0.9))}.items():\n    r=solve_q1(price1,load1,pv1,ec,ed)\n    print('  口径 %-12s status=%s  最优购电费 = %.2f 元' % (name, r.status, r.fun))\n\nr=solve_q1(price1,load1,pv1)\nT=144; g=r.x[:T]; ch=r.x[T:2*T]; dis=r.x[2*T:]\nprint('  独立最优(双侧90%%) 全天购电量 %.2f kWh, 费用 %.2f' % (g.sum(), r.fun))\n\n# 读 result1 校验\nR1p=pd.read_excel('result/result1.xlsx', sheet_name='计划购电量')\nR1s=pd.read_excel('result/result1.xlsx', sheet_name='充放电量')\ngr=R1p['购电量'].to_numpy(float)\nprint('  result1 全天购电量 %.2f kWh' % gr.sum())\nprint('  result1 购电费(按口径A: 第k行配第k列电价) = %.2f 元' % (gr*price1).sum())\nprint('  result1 购电费(按口径B: 标签对齐,即第k行配第k列同样) = 同上 (标签与位置的差异只影响解释)')\nprint('  与独立最优差 = %.2f 元 (%.4f%%)' % ((gr*price1).sum()-r.fun, ((gr*price1).sum()-r.fun)/r.fun*100))\nprint(R1s.to_string())\nch_t=R1s['充电量'].sum(); dis_t=R1s['放电量'].sum()\nprint('  result1 总充 %.2f 总放 %.2f  SOC闭合检验 0.9*ch-dis/0.9 = %.4f (应=0)' % (ch_t,dis_t, 0.9*ch_t-dis_t/0.9))\n# 供需平衡（按口径A逐slot不可得，只能日级）\nprint('  日级: 购电 %.1f + 光伏 %.1f + 放 %.1f - 充 %.1f = %.1f  vs 负载 %.1f  余 %.1f'\n      % (gr.sum(), pv1.sum()/6, dis_t, ch_t, gr.sum()+pv1.sum()/6+dis_t-ch_t, load1.sum()/6,\n         gr.sum()+pv1.sum()/6+dis_t-ch_t-load1.sum()/6))\nEOF\npython _audit1.py", "description": "运行独立审计脚本一"}, "output": null}
