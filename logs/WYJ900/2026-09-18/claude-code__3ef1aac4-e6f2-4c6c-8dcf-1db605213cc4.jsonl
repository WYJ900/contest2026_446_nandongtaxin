{"schema_version": "1.0", "session_id": "3ef1aac4-e6f2-4c6c-8dcf-1db605213cc4", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 17, "ts": "2026-09-11T06:47:43.182Z", "role": "tool", "tool_name": "<result>", "tool_call_id": "toolu_bdrk_01B6vtind3qfwb2g9oFa21XF", "input": null, "output": "1\t\"\"\"\n2\t统一数据加载层（P0）\n3\t\n4\t口径约定（详见 00_赛题理解与陷阱记录.md 第五节）：\n5\t    采用「口径 A（区间末端）」——附件中时刻 t 处的功率视为区间 (t-10min, t] 上的\n6\t    平均功率。全天划分为 slot 1..144，slot k 覆盖 [(k-1)*10min, k*10min]，\n7\t    恰好覆盖 0:00 -> 24:00。\n8\t\n9\t    附件 1/2/4 的第 k 个数据列（时间轴 0:10, 0:20, ..., 23:50, 0:00+1）\n10\t    即对应 slot k。数组索引 0..143 对应 slot 1..144。\n11\t\n12\t    4 小时分桶：slot 1-24 / 25-48 / 49-72 / 73-96 / 97-120 / 121-144（整除）。\n13\t\n14\t    写盘时按「位置」对齐：slot k 的结果写入模板第 k 个数据行/列，不修改模板标签。\n15\t\"\"\"\n16\tfrom __future__ import annotations\n17\t\n18\timport datetime as _dt\n19\tfrom dataclasses import dataclass\n20\tfrom pathlib import Path\n21\t\n22\timport numpy as np\n23\timport openpyxl\n24\t\n25\t# ---------------------------------------------------------------- 常量\n26\t\n27\tROOT = Path(__file__).resolve().parent.parent\n28\tATT = ROOT / \"附件\"\n29\t\n30\tN_SLOT = 144                  # 每天时段数\n31\tDT_H = 1.0 / 6.0              # 每时段时长（小时）\n32\tN_BUCKET = 6                  # 4 小时桶数\n33\tSLOT_PER_BUCKET = N_SLOT // N_BUCKET   # 24\n34\t\n35\t# 储能参数（附录1）\n36\tCAP_MAX = 12000.0             # kWh，最大容量（被 SOC_HI 支配，永不触及）\n37\tP_ESS_MAX = 5000.0            # kW，最大充放电功率\n38\tSOC_INIT = 6000.0             # kWh，2025-01-01 0:00 储电量\n39\tSOC_LO = 1200.0               # kWh，运行下限\n40\tSOC_HI = 10800.0              # kWh，运行上限\n41\tETA = 0.90                    # 充放电效率\n42\t\n43\tE_ESS_MAX = P_ESS_MAX * DT_H  # kWh，单时段最大充/放电量 = 833.33\n44\t\n45\tBUCKET_LABELS = [\"0:00-4:00\", \"4:00-8:00\", \"8:00-12:00\",\n46\t                 \"12:00-16:00\", \"16:00-20:00\", \"20:00-24:00\"]\n47\t\n48\t# 问2/问3 结果覆盖区间\n49\tOUT_START = _dt.date(2025, 2, 1)\n50\tOUT_END = _dt.date(2025, 12, 31)\n51\t\n52\t# 表3 指定日期（春分/夏至/秋分/冬至）\n53\tKEY_DATES = [_dt.date(2025, 3, 20), _dt.date(2025, 6, 21),\n54\t             _dt.date(2025, 9, 23), _dt.date(2025, 12, 21)]\n55\t\n56\t\n57\t# ---------------------------------------------------------------- 工具\n58\t\n59\tdef slot_label(k: int) -> str:\n60\t    \"\"\"slot k (1-based) 的真实时间段标签，如 k=1 -> '0:00-0:10'。\"\"\"\n61\t    a, b = (k - 1) * 10, k * 10\n62\t    return f\"{a // 60}:{a % 60:02d}-{b // 60}:{b % 60:02d}\"\n63\t\n64\t\n65\tdef bucket_of(k: int) -> int:\n66\t    \"\"\"slot k (1-based) 所属 4h 桶索引 (0-based)。\"\"\"\n67\t    return (k - 1) // SLOT_PER_BUCKET\n68\t\n69\t\n70\tdef _read_matrix(path: Path, sheet: str) -> tuple[list[_dt.date], np.ndarray]:\n71\t    \"\"\"读取「日期 x 144 时段」型工作表，返回 (日期列表, (n_day,144) 数组)。\"\"\"\n72\t    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)\n73\t    ws = wb[sheet]\n74\t    dates: list[_dt.date] = []\n75\t    rows: list[list[float]] = []\n76\t    for row in ws.iter_rows(min_row=2, values_only=True):\n77\t        if row[0] is None:\n78\t            continue\n79\t        d = row[0]\n80\t        dates.append(d.date() if isinstance(d, _dt.datetime) else d)\n81\t        vals = [float(v) if v is not None else 0.0 for v in row[1:1 + N_SLOT]]\n82\t        if len(vals) != N_SLOT:\n83\t            raise ValueError(f\"{path.name}/{sheet} 行 {dates[-1]} 列数={len(vals)}\")\n84\t        rows.append(vals)\n85\t    wb.close()\n86\t    return dates, np.asarray(rows, dtype=float)\n87\t\n88\t\n89\t# ---------------------------------------------------------------- 数据容器\n90\t\n91\t@dataclass\n92\tclass TypicalDay:\n93\t    \"\"\"附件1：典型日（已实测 = 附件2/4 的全年逐时段均值，即日前期望曲线）。\"\"\"\n94\t    price: np.ndarray     # (144,) 元/kWh\n95\t    load: np.ndarray      # (144,) kW\n96\t    pv: np.ndarray        # (144,) kW\n97\t\n98\t\n99\t@dataclass\n100\tclass Dataset:\n101\t    typical: TypicalDay\n102\t    dates: list[_dt.date]                  # 365 天\n103\t    load: np.ndarray                       # (365,144) kW，附件2\n104\t    pv: np.ndarray                         # (365,144) kW，附件2 实际\n105\t    price_dyn: np.ndarray                  # (365,144) 元/kWh，附件4\n106\t    fc: dict[tuple[_dt.date, int], np.ndarray]   # (date, 发布时刻h) -> (144,) kW\n107\t    _didx: dict[_dt.date, int]\n108\t\n109\t    # -------- 便捷访问\n110\t\n111\t    def day(self, d: _dt.date) -> int:\n112\t        return self._didx[d]\n113\t\n114\t    def load_of(self, d: _dt.date) -> np.ndarray:\n115\t        return self.load[self._didx[d]]\n116\t\n117\t    def pv_of(self, d: _dt.date) -> np.ndarray:\n118\t        return self.pv[self._didx[d]]\n119\t\n120\t    def price_of(self, d: _dt.date, dynamic: bool = False) -> np.ndarray:\n121\t        \"\"\"问1-3 用附件1 固定电价；问4 用附件4 逐日电价。\"\"\"\n122\t        return self.price_dyn[self._didx[d]] if dynamic else self.typical.price\n123\t\n124\t    def forecast(self, d: _dt.date, issue_h: int) -> np.ndarray:\n125\t        \"\"\"d 日 issue_h 时刻发布的预报，插值到 144 slot。\n126\t\n127\t        仅当日 slot 有效；发布时刻之前的 slot 返回 nan（不可用于决策）。\n128\t        \"\"\"\n129\t        return self.fc[(d, issue_h)]\n130\t\n131\t    def out_dates(self) -> list[_dt.date]:\n132\t        return [d for d in self.dates if OUT_START <= d <= OUT_END]\n133\t\n134\t\n135\t# ---------------------------------------------------------------- 附件3 预报插值\n136\t\n137\tdef _interp_forecast(fc_hourly: np.ndarray, issue_h: int,\n138\t                     anchor_val: float | None = None) -> np.ndarray:\n139\t    \"\"\"把 24 个整点预报插值到当日 144 个 slot。\n140\t\n141\t    对齐关系（已用 MAE 扫偏移实测，offset=0 最优）：\n142\t        issue_h 时刻发布的「预报 h 小时」对应时点 issue_h + h，\n143\t        即 slot 索引 6*(issue_h + h)（1-based）。\n144\t\n145\t    口径 A 下 slot k 代表区间 ((k-1)*10min, k*10min]，其右端点时刻为 k*10min。\n146\t    故已知节点为 (slot = 6*(issue_h+h), value = fc[h-1])，在 slot 轴上线性插值。\n147\t\n148\t    左端锚点：发布时刻 issue_h 处的实况值（决策者在该时刻已知当前出力，\n149\t    属合法信息集）。若不提供则退化为用首个预报值平推——那会把 T+1h 的值\n150\t    贴满整个 (T, T+1h] 区间，在日出爬坡段造成大幅高估，故默认应提供。\n151\t\n152\t    返回 (144,) 数组；发布时刻之前的 slot 置 nan（不可用于决策）。\n153\t    \"\"\"\n154\t    ks, vs = [], []\n155\t    for h in range(1, 25):\n156\t        k = 6 * (issue_h + h)\n157\t        if 1 <= k <= N_SLOT:                 # 截断到当日 24:00\n158\t            ks.append(float(k))\n159\t            vs.append(fc_hourly[h - 1])\n160\t    out = np.full(N_SLOT, np.nan)\n161\t    if not ks:\n162\t        return out\n163\t    ks_a = np.asarray(ks, dtype=float)\n164\t    vs_a = np.asarray(vs, dtype=float)\n165\t\n166\t    # 左锚点 = 发布时刻处的实况（issue_h=0 时为 0:00，取前一日末值不可得，用 0）\n167\t    k_issue = float(6 * issue_h)\n168\t    if k_issue < ks_a[0]:\n169\t        v0 = 0.0 if anchor_val is None else float(anchor_val)\n170\t        ks_a = np.concatenate([[k_issue], ks_a])\n171\t        vs_a = np.concatenate([[v0], vs_a])\n172\t\n173\t    lo = int(np.ceil(max(ks_a[0], 1.0)))\n174\t    hi = int(np.floor(ks_a[-1]))\n175\t    grid = np.arange(lo, min(hi, N_SLOT) + 1)\n176\t    if grid.size:\n177\t        out[grid - 1] = np.interp(grid.astype(float), ks_a, vs_a)\n178\t\n179\t    # 末段（最后一个整点之后到 24:00）保持最后已知值\n180\t    if hi < N_SLOT:\n181\t        out[hi:] = vs_a[-1]\n182\t\n183\t    np.clip(out, 0.0, None, out=out)          # 光伏出力非负\n184\t    return out\n185\t\n186\t\n187\tdef _load_forecast(path: Path,\n188\t                   pv_actual: dict[_dt.date, np.ndarray],\n189\t                   ) -> dict[tuple[_dt.date, int], np.ndarray]:\n190\t    \"\"\"读附件3 并插值到 10min 网格。\n191\t\n192\t    pv_actual 提供发布时刻的实况值作为插值左锚点（决策者在发布时刻已知\n193\t    当前出力，属合法信息集，不构成未来信息泄露）。\n194\t    \"\"\"\n195\t    wb = openpyxl.load_workbook(path, data_only=True)\n196\t    ws = wb[\"Sheet1\"]\n197\t    out: dict[tuple[_dt.date, int], np.ndarray] = {}\n198\t    cur: _dt.date | None = None\n199\t    for row in ws.iter_rows(min_row=2, values_only=True):\n200\t        if row[0]:                                        # 合并单元格 -> 前向填充\n201\t            y, m, dd = (int(x) for x in str(row[0]).split(\"-\"))\n202\t            cur = _dt.date(y, m, dd)\n203\t        if cur is None or row[1] is None:\n204\t            continue\n205\t        issue_h = int(str(row[1]).split(\":\")[0])\n206\t        hourly = np.asarray([float(v) if v is not None else 0.0\n207\t                             for v in row[2:26]], dtype=float)\n208\t        # 发布时刻 issue_h 对应 slot 6*issue_h（其右端点即该时刻）\n209\t        anchor = None\n210\t        act = pv_actual.get(cur)\n211\t        if act is not None and issue_h > 0:\n212\t            anchor = float(act[6 * issue_h - 1])\n213\t        elif issue_h == 0:\n214\t            anchor = 0.0                                  # 0:00 光伏必为 0\n215\t        out[(cur, issue_h)] = _interp_forecast(hourly, issue_h, anchor)\n216\t    wb.close()\n217\t    return out\n218\t\n219\t\n220\t# ---------------------------------------------------------------- 主入口\n221\t\n222\tdef load_all(verbose: bool = False) -> Dataset:\n223\t    wb = openpyxl.load_workbook(ATT / \"附件1.xlsx\", data_only=True)\n224\t    rows = list(wb[\"Sheet1\"].iter_rows(min_row=2, values_only=True))[:N_SLOT]\n225\t    wb.close()\n226\t    typical = TypicalDay(\n227\t        price=np.asarray([float(r[1]) for r in rows]),\n228\t        load=np.asarray([float(r[2]) for r in rows]),\n229\t        pv=np.asarray([float(r[3]) for r in rows]),\n230\t    )\n231\t\n232\t    dates, load = _read_matrix(ATT / \"附件2.xlsx\", \"小区负载\")\n233\t    d2, pv = _read_matrix(ATT / \"附件2.xlsx\", \"光伏发电实际功率\")\n234\t    d4, price_dyn = _read_matrix(ATT / \"附件4.xlsx\", \"Sheet1\")\n235\t    if dates != d2 or dates != d4:\n236\t        raise ValueError(\"附件2/附件4 日期轴不一致\")\n237\t\n238\t    pv_actual = {d: pv[i] for i, d in enumerate(dates)}\n239\t    ds = Dataset(\n240\t        typical=typical, dates=dates, load=load, pv=pv, price_dyn=price_dyn,\n241\t        fc=_load_forecast(ATT / \"附件3.xlsx\", pv_actual),\n242\t        _didx={d: i for i, d in enumerate(dates)},\n243\t    )\n244\t    if verbose:\n245\t        _selftest(ds)\n246\t    return ds\n247\t\n248\t\n249\t# ---------------------------------------------------------------- 自检\n250\t\n251\tdef _selftest(ds: Dataset) -> None:\n252\t    print(f\"[data] 天数={len(ds.dates)}  {ds.dates[0]} .. {ds.dates[-1]}\")\n253\t    print(f\"[data] 输出区间天数={len(ds.out_dates())} (应为 334)\")\n254\t    print(f\"[data] 预报条目={len(ds.fc)} (应为 365*4=1460)\")\n255\t\n256\t    # 附件1 == 附件2/4 年均（已知结论，作为回归检验）\n257\t    for name, a, b in [(\"电价\", ds.typical.price, ds.price_dyn.mean(0)),\n258\t                       (\"负载\", ds.typical.load, ds.load.mean(0)),\n259\t                       (\"光伏\", ds.typical.pv, ds.pv.mean(0))]:\n260\t        print(f\"[data] 附件1 {name} vs 年均 max|dev| = {np.abs(a - b).max():.3e}\")\n261\t\n262\t    # 4h 桶整除\n263\t    cnt = [sum(1 for k in range(1, N_SLOT + 1) if bucket_of(k) == b)\n264\t           for b in range(N_BUCKET)]\n265\t    assert cnt == [SLOT_PER_BUCKET] * N_BUCKET, cnt\n266\t    print(f\"[data] 4h 桶 slot 数={cnt}  标签[0]={slot_label(1)} 标签[143]={slot_label(144)}\")\n267\t\n268\t    # 预报精度（口径校验：与实际值的 MAE 应随发布时刻递减）\n269\t    for h in (0, 6, 12, 18):\n270\t        errs = []\n271\t        for d in ds.dates:\n272\t            f = ds.fc.get((d, h))\n273\t            if f is None:\n274\t                continue\n275\t            a = ds.pv_of(d)\n276\t            m = ~np.isnan(f)\n277\t            m[:6 * h] = False                      # 只看发布时刻之后\n278\t            if m.any():\n279\t                errs.append(np.abs(f[m] - a[m]))\n280\t        e = np.concatenate(errs)\n281\t        print(f\"[data] {h:2d}:00 预报 MAE={e.mean():7.2f} kW  RMSE={np.sqrt((e**2).mean()):7.2f}  n={e.size}\")\n282\t\n283\t\n284\tif __name__ == \"__main__\":\n285\t    load_all(verbose=True)\n286\t", "is_error": false}
{"schema_version": "1.0", "session_id": "3ef1aac4-e6f2-4c6c-8dcf-1db605213cc4", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 18, "ts": "2026-09-11T06:47:43.590Z", "model": "claude-opus-5", "tokens_in": 4800, "tokens_out": 77, "role": "tool", "tool_name": "Read", "tool_call_id": "toolu_bdrk_01QzqSKmuUBHSn5Eqqk3wqd1", "input": {"file_path": "D:\\desktop\\C题\\code\\solve_q1.py"}, "output": null}
{"schema_version": "1.0", "session_id": "3ef1aac4-e6f2-4c6c-8dcf-1db605213cc4", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 19, "ts": "2026-09-11T06:47:43.597Z", "role": "tool", "tool_name": "<result>", "tool_call_id": "toolu_bdrk_01QzqSKmuUBHSn5Eqqk3wqd1", "input": null, "output": "1\t\"\"\"问1：确定性 LP（口径 A，slot k = [(k-1)*10min, k*10min]，k=1..144）\n2\t\n3\t变量（每 slot 各一个，共 4*144 = 576）：\n4\t    q_k >= 0   购电量 (kWh)\n5\t    c_k >= 0   充电量：从母线吸收 (kWh)\n6\t    d_k >= 0   放电量：向母线释放 (kWh)\n7\t    S_k        slot k 末储电量 (kWh)\n8\t\n9\tSOC 递推（效率口径可切换）：\n10\t    S_k = S_{k-1} + eta_c * c_k - d_k / eta_d\n11\t供电约束（>= 允许弃光，不允许售电）：\n12\t    pv_k*dt + q_k + d_k - c_k >= load_k*dt\n13\t目标：\n14\t    min  sum_k price_k * q_k        [元]\n15\t\"\"\"\n16\tfrom __future__ import annotations\n17\t\n18\timport numpy as np\n19\tfrom scipy.optimize import linprog\n20\tfrom scipy.sparse import csr_matrix, hstack, vstack, eye, diags\n21\t\n22\timport data_loader as D\n23\t\n24\tN = D.N_SLOT\n25\tDT = D.DT_H\n26\tE_MAX = D.E_ESS_MAX          # 833.33 kWh，单 slot 充/放上限\n27\t\n28\t\n29\t# ---------------------------------------------------------------- 效率口径\n30\t\n31\tETA_MODES = {\n32\t    # name: (eta_c, eta_d)   S += eta_c*c - d/eta_d\n33\t    \"双侧90\":  (0.90, 0.90),          # 最литeral 读法，往返 0.81\n34\t    \"往返90\":  (np.sqrt(0.9), np.sqrt(0.9)),   # 往返 0.90\n35\t    \"单侧90\":  (0.90, 1.00),          # 仅充电侧损耗\n36\t}\n37\t\n38\t\n39\tdef build_and_solve(price: np.ndarray, load: np.ndarray, pv: np.ndarray,\n40\t                    soc0: float, soc_end: float | None,\n41\t                    eta_c: float, eta_d: float,\n42\t                    soc_lo: float = D.SOC_LO, soc_hi: float = D.SOC_HI,\n43\t                    ) -> dict:\n44\t    \"\"\"求解单日 LP。\n45\t\n46\t    soc_end=None 表示「首末相等但数值自由」（附加 S_144 == soc0 由调用方控制）；\n47\t    此处 soc_end 给定则强制 S_144 = soc_end。\n48\t    \"\"\"\n49\t    Z = csr_matrix((N, N))\n50\t    I = eye(N, format=\"csr\")\n51\t\n52\t    # --- 等式：SOC 递推  S_k - S_{k-1} - eta_c*c_k + d_k/eta_d = 0\n53\t    # 下三角差分矩阵 D_S: S_k - S_{k-1}\n54\t    Dm = eye(N, format=\"csr\") - eye(N, k=-1, format=\"csr\")\n55\t    A_eq = hstack([Z, -eta_c * I, (1.0 / eta_d) * I, Dm], format=\"csr\")\n56\t    b_eq = np.zeros(N)\n57\t    b_eq[0] = soc0                      # k=1 时 S_0 = soc0 移到右端\n58\t\n59\t    # --- 等式：末端 SOC\n60\t    if soc_end is not None:\n61\t        row = np.zeros(4 * N)\n62\t        row[3 * N + (N - 1)] = 1.0\n63\t        A_eq = vstack([A_eq, csr_matrix(row)], format=\"csr\")\n64\t        b_eq = np.append(b_eq, soc_end)\n65\t\n66\t    # --- 不等式：供电约束  -q_k - d_k + c_k <= (pv_k - load_k)*dt\n67\t    A_ub = hstack([-I, I, -I, Z], format=\"csr\")\n68\t    b_ub = (pv - load) * DT\n69\t\n70\t    # --- 目标\n71\t    cvec = np.concatenate([price, np.zeros(N), np.zeros(N), np.zeros(N)])\n72\t\n73\t    bounds = ([(0.0, None)] * N              # q\n74\t              + [(0.0, E_MAX)] * N           # c\n75\t              + [(0.0, E_MAX)] * N           # d\n76\t              + [(soc_lo, soc_hi)] * N)      # S\n77\t\n78\t    res = linprog(cvec, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq,\n79\t                  bounds=bounds, method=\"highs\")\n80\t    if not res.success:\n81\t        raise RuntimeError(res.message)\n82\t\n83\t    q, c, d, S = (res.x[:N], res.x[N:2 * N], res.x[2 * N:3 * N], res.x[3 * N:])\n84\t    return dict(cost=float(cvec @ res.x), q=q, c=c, d=d, S=S,\n85\t                soc0=soc0, res=res)\n86\t\n87\t\n88\tdef report(sol: dict, price: np.ndarray, load: np.ndarray, pv: np.ndarray,\n89\t           tag: str = \"\") -> None:\n90\t    q, c, d, S = sol[\"q\"], sol[\"c\"], sol[\"d\"], sol[\"S\"]\n91\t    both = np.sum((c > 1e-6) & (d > 1e-6))\n92\t    supply = pv * DT + q + d - c\n93\t    slack = supply - load * DT\n94\t    print(f\"--- {tag}\")\n95\t    print(f\"    购电费   = {sol['cost']:12.2f} 元\")\n96\t    print(f\"    购电量   = {q.sum():12.2f} kWh\")\n97\t    print(f\"    充/放    = {c.sum():10.2f} / {d.sum():10.2f} kWh\"\n98\t          f\"   同时充放 slot 数={both}\")\n99\t    print(f\"    SOC      = [{S.min():.1f}, {S.max():.1f}]  \"\n100\t          f\"S0={sol['soc0']:.1f} -> S144={S[-1]:.1f}\")\n101\t    print(f\"    弃光量   = {slack.sum():12.2f} kWh   最小裕度={slack.min():.3e}\")\n102\t\n103\t\n104\tif __name__ == \"__main__\":\n105\t    ds = D.load_all()\n106\t    price, load, pv = ds.typical.price, ds.typical.load, ds.typical.pv\n107\t    print(f\"日负载 {load.sum()*DT:.1f} kWh   日光伏 {pv.sum()*DT:.1f} kWh   \"\n108\t          f\"净缺口 {(load-pv).sum()*DT:.1f} kWh\\n\")\n109\t\n110\t    print(\"=\" * 68)\n111\t    print(\"效率口径敏感性（S_0 = S_144 = 6000）\")\n112\t    print(\"=\" * 68)\n113\t    base = {}\n114\t    for name, (ec, ed) in ETA_MODES.items():\n115\t        sol = build_and_solve(price, load, pv, 6000.0, 6000.0, ec, ed)\n116\t        base[name] = sol\n117\t        report(sol, price, load, pv, f\"{name}  (eta_c={ec:.4f}, eta_d={ed:.4f})\")\n118\t\n119\t    print()\n120\t    print(\"=\" * 68)\n121\t    print(\"首末 SOC 取值：固定 6000 vs 自由但相等\")\n122\t    print(\"=\" * 68)\n123\t    ec, ed = ETA_MODES[\"双侧90\"]\n124\t    fix = base[\"双侧90\"]\n125\t    best, best_v = None, None\n126\t    for v in range(int(D.SOC_LO), int(D.SOC_HI) + 1, 200):\n127\t        s = build_and_solve(price, load, pv, float(v), float(v), ec, ed)\n128\t        if best is None or s[\"cost\"] < best[\"cost\"]:\n129\t            best, best_v = s, v\n130\t    print(f\"    固定 6000       购电费 = {fix['cost']:12.2f} 元\")\n131\t    print(f\"    最优等值 {best_v:5d}   购电费 = {best['cost']:12.2f} 元\"\n132\t          f\"   省 {fix['cost']-best['cost']:.2f} 元\")\n133\t", "is_error": false}
{"schema_version": "1.0", "session_id": "3ef1aac4-e6f2-4c6c-8dcf-1db605213cc4", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 20, "ts": "2026-09-11T06:47:43.947Z", "model": "claude-opus-5", "tokens_in": 4800, "tokens_out": 77, "role": "tool", "tool_name": "Read", "tool_call_id": "toolu_bdrk_01Ppe4m6XoDrQUqME7s2va59", "input": {"file_path": "D:\\desktop\\C题\\code\\output_q1.py"}, "output": null}
{"schema_version": "1.0", "session_id": "3ef1aac4-e6f2-4c6c-8dcf-1db605213cc4", "team_id": "contest2026_446_nandongtaxin", "github_login": "WYJ900", "tool": "claude-code", "seq": 21, "ts": "2026-09-11T06:47:43.955Z", "role": "tool", "tool_name": "<result>", "tool_call_id": "toolu_bdrk_01Ppe4m6XoDrQUqME7s2va59", "input": null, "output": "1\t\"\"\"问1 交付物：表1、表2 数字 + result1.xlsx\n2\t\n3\t写盘规则（口径 A，见 00_赛题理解与陷阱记录.md 第五节）：\n4\t    slot k 的结果写入模板第 k 个数据位置（第 k+1 行），不修改模板标签文字。\n5\t    模板标签 '0:10-0:20' 对应本文第 1 个时段 0:00-0:10，依此类推。\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport shutil\n10\tfrom pathlib import Path\n11\t\n12\timport numpy as np\n13\timport openpyxl\n14\t\n15\timport data_loader as D\n16\timport solve_q1 as Q\n17\t\n18\tOUT = D.ROOT / \"result\" / \"result1.xlsx\"\n19\tTPL = D.ATT / \"附件5\" / \"result1.xlsx\"\n20\t\n21\t# 表1 指定时间段（题目原文）\n22\tT1_SEGS = [\"10:00-10:10\", \"12:00-12:10\", \"14:00-14:10\",\n23\t           \"16:00-16:10\", \"18:00-18:10\", \"20:00-20:10\"]\n24\t\n25\t\n26\tdef slot_of(label: str) -> int:\n27\t    \"\"\"真实时间段标签 -> slot 编号 (1-based)。'10:00-10:10' -> 61\"\"\"\n28\t    hh, mm = label.split(\"-\")[0].split(\":\")\n29\t    return int(hh) * 6 + int(mm) // 10 + 1\n30\t\n31\t\n32\tdef main(mode: str = \"双侧90\") -> None:\n33\t    ds = D.load_all()\n34\t    p, l, v = ds.typical.price, ds.typical.load, ds.typical.pv\n35\t    ec, ed = Q.ETA_MODES[mode]\n36\t    sol = Q.build_and_solve(p, l, v, D.SOC_INIT, D.SOC_INIT, ec, ed)\n37\t    q, c, d, S = sol[\"q\"], sol[\"c\"], sol[\"d\"], sol[\"S\"]\n38\t\n39\t    # ---------------- 表1\n40\t    print(\"=\" * 62)\n41\t    print(f\"表1  微网在指定时间段的购电量及全天的购电量和购电费\"\n42\t          f\"   [效率口径 {mode}]\")\n43\t    print(\"=\" * 62)\n44\t    for i in range(0, len(T1_SEGS), 3):\n45\t        cells = []\n46\t        for lab in T1_SEGS[i:i + 3]:\n47\t            k = slot_of(lab)\n48\t            cells.append(f\"{lab}  {q[k - 1]:9.2f}\")\n49\t        print(\"   \" + \" | \".join(cells))\n50\t    print(f\"\\n   全天购电量 = {q.sum():12.2f} kWh\")\n51\t    print(f\"   全天购电费 = {sol['cost']:12.2f} 元\")\n52\t\n53\t    # ---------------- 表2\n54\t    print()\n55\t    print(\"=\" * 62)\n56\t    print(\"表2  储能设备在指定时间段的充放电量及 0:00 和 24:00 的储电量\")\n57\t    print(\"=\" * 62)\n58\t    ch = np.zeros(D.N_BUCKET)\n59\t    di = np.zeros(D.N_BUCKET)\n60\t    for k in range(1, D.N_SLOT + 1):\n61\t        b = D.bucket_of(k)\n62\t        ch[b] += c[k - 1]\n63\t        di[b] += d[k - 1]\n64\t    print(f\"   {'时间段':<14}{'充电量':>12}{'放电量':>12}\")\n65\t    for b, lab in enumerate(D.BUCKET_LABELS):\n66\t        print(f\"   {lab:<14}{ch[b]:>12.2f}{di[b]:>12.2f}\")\n67\t    print(f\"   {'合计':<14}{ch.sum():>12.2f}{di.sum():>12.2f}\")\n68\t    print(f\"\\n   0:00  储电量 = {D.SOC_INIT:9.2f} kWh\")\n69\t    print(f\"   24:00 储电量 = {S[-1]:9.2f} kWh\")\n70\t\n71\t    # ---------------- 校核\n72\t    print()\n73\t    print(\"=\" * 62)\n74\t    print(\"校核\")\n75\t    print(\"=\" * 62)\n76\t    supply = v * D.DT_H + q + d - c\n77\t    need = l * D.DT_H\n78\t    print(f\"   供电 >= 负载 最小裕度   = {(supply - need).min():+.3e} kWh\")\n79\t    print(f\"   同时充放 slot 数        = {int(((c>1e-6)&(d>1e-6)).sum())}\")\n80\t    print(f\"   SOC 区间                = [{S.min():.2f}, {S.max():.2f}]\"\n81\t          f\"   (约束 [{D.SOC_LO}, {D.SOC_HI}])\")\n82\t    print(f\"   单 slot 充放上限        = {max(c.max(), d.max()):.2f}\"\n83\t          f\"   (约束 {Q.E_MAX:.2f})\")\n84\t    print(f\"   SOC 递推残差            = \"\n85\t          f\"{np.abs(np.diff(np.r_[D.SOC_INIT, S]) - (ec*c - d/ed)).max():.3e}\")\n86\t    print(f\"   首末储电量之差          = {S[-1] - D.SOC_INIT:+.3e} kWh\")\n87\t\n88\t    # ---------------- 写盘\n89\t    OUT.parent.mkdir(exist_ok=True)\n90\t    shutil.copy(TPL, OUT)\n91\t    wb = openpyxl.load_workbook(OUT)\n92\t\n93\t    # 购电量按 4 位小数【向上】取整：四舍五入会使 38 个时段的供电约束\n94\t    # 微量违约（5e-5 kWh），虽量级极小但严格违反\"电能不可低于负载\"。\n95\t    # 向上取整保证结果文件严格可行，代价仅 +2e-4 元。\n96\t    q_out = np.ceil(q * 1e4) / 1e4\n97\t    ws = wb[\"计划购电量\"]\n98\t    for k in range(1, D.N_SLOT + 1):\n99\t        ws.cell(row=k + 1, column=2, value=float(q_out[k - 1]))\n100\t\n101\t    # 充放电量表：A=时间段 B=充电量 C=放电量 D=时刻 E=储电量\n102\t    #\n103\t    # 桶值取 6 位小数而非 4 位：4 位时由桶值递推末端 SOC 得 5999.9999，\n104\t    # 与表中填的 6000.0000 差 6.6e-5，评委按桶值验算会对不上。\n105\t    # 6 位小数使递推残差降到 1e-9 量级，表格内部自洽。\n106\t    ws2 = wb[\"充放电量\"]\n107\t    for b in range(D.N_BUCKET):\n108\t        ws2.cell(row=b + 2, column=2, value=round(float(ch[b]), 6))\n109\t        ws2.cell(row=b + 2, column=3, value=round(float(di[b]), 6))\n110\t    ws2.cell(row=2, column=5, value=round(float(D.SOC_INIT), 4))   # 0:00\n111\t    ws2.cell(row=3, column=5, value=round(float(S[-1]), 4))        # 24:00\n112\t\n113\t    wb.save(OUT)\n114\t    print(f\"\\n   已写入 {OUT}\")\n115\t\n116\t    # ---------------- 写盘后复核（以文件内容为准，而非内存中的解）\n117\t    print()\n118\t    print(\"=\" * 62)\n119\t    print(\"写盘后复核（读回文件校验）\")\n120\t    print(\"=\" * 62)\n121\t    wbr = openpyxl.load_workbook(OUT, data_only=True)\n122\t    qr = np.array([r[1] for r in\n123\t                   list(wbr[\"计划购电量\"].iter_rows(values_only=True))[1:]],\n124\t                  dtype=float)\n125\t    rr = list(wbr[\"充放电量\"].iter_rows(values_only=True))\n126\t    chr_ = np.array([rr[i][1] for i in range(1, 7)], dtype=float)\n127\t    dir_ = np.array([rr[i][2] for i in range(1, 7)], dtype=float)\n128\t    s0r, s1r = float(rr[1][4]), float(rr[2][4])\n129\t\n130\t    supply = v * D.DT_H + qr + d - c\n131\t    margin = supply - l * D.DT_H\n132\t    print(f\"   读回购电量和   = {qr.sum():14.4f} kWh\")\n133\t    print(f\"   读回购电费     = {float(p @ qr):14.4f} 元\")\n134\t    print(f\"   供电约束最小裕度 = {margin.min():+.3e} kWh\"\n135\t          f\"   违约时段数 {int((margin < -1e-9).sum())}\")\n136\t    soc_end = D.SOC_INIT + ec * chr_.sum() - dir_.sum() / ed\n137\t    print(f\"   由桶值重算末端 SOC = {soc_end:.4f}\"\n138\t          f\"   表中 24:00 储电量 = {s1r:.4f}\")\n139\t    print(f\"   0:00 储电量 = {s0r:.4f}   首末之差 = {s1r - s0r:+.4f}\")\n140\t\n141\t\n142\tif __name__ == \"__main__\":\n143\t    main()\n144\t", "is_error": false}
