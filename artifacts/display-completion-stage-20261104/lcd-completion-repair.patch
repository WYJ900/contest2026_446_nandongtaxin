+/* Bounded, UI-thread-only reproduction of the native honeycomb redraw. */
+static void honey_bench_step(void)
+{
+  static const int points[][2]={{0,0},{-160,120},{180,-140},{-180,-120},{160,140},{0,0}};
+  static int step=-1;
