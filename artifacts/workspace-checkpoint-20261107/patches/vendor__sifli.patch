+static int adc_read(ADC_HandleTypeDef *adc_handle, uint8_t channel,
+                    uint32_t *sample)
+{
+    int ret;
+    uint32_t value;
+    ADC_ChannelConfTypeDef chan_cfg;
+
+    memset(&chan_cfg, 0, sizeof(chan_cfg));
+    chan_cfg.pchnl_sel = channel;
+    chan_cfg.slot_en = 1;
+    chan_cfg.nchnl_sel = 0;
+    chan_cfg.Channel = 0;
+    chan_cfg.acc_num = 0;
