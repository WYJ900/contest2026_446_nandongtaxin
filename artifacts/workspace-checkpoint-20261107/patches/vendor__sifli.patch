+/* Panel reset and sleep-out delays run in task context. A calibrated busy
+ * loop can under-delay when the CPU clock or instruction cache changes.
+ */
+
+static void co5300_delay_ms(unsigned int ms)
+{
+    while (nxsig_usleep(ms * 1000) == -EINTR)
+    {
+    }
+}
+
+int co5300_check_state(LCDC_HandleTypeDef *hlcdc)
+{
+    uint8_t power = 0;
+    uint8_t format = 0;
+    HAL_StatusTypeDef ret1;
+    HAL_StatusTypeDef ret2;
+
+    LCD_ReadMode(hlcdc, true);
+    ret1 = HAL_LCDC_ReadU32Reg(hlcdc, (0x03u << 24) | (0x0au << 8),
+                             &power, 1);
+    ret2 = HAL_LCDC_ReadU32Reg(hlcdc, (0x03u << 24) | (0x0cu << 8),
+                             &format, 1);
+    LCD_ReadMode(hlcdc, false);
+    if (ret1 != HAL_OK || ret2 != HAL_OK)
+    {
+        return -EIO;
+    }
+
+    if ((power & 0x14) != 0x14 || format != 0x55)
+    {
+        syslog(LOG_WARNING, "CO5300: state lost power=%02x format=%02x\n",
+               power, format);
+        return 1;
+    }
+
+    return 0;
+}
+
+void co5300_dump_state(LCDC_HandleTypeDef *hlcdc)
+{
+    static const uint8_t regs[] = {0x04, 0x0a, 0x0c, 0x52, 0x54};
+    unsigned int i;
+
+    LCD_ReadMode(hlcdc, true);
+    for (i = 0; i < sizeof(regs); i++)
+    {
+        uint32_t value = 0;
+        HAL_StatusTypeDef ret;
+
+        ret = HAL_LCDC_ReadU32Reg(hlcdc,
+                                 (0x03u << 24) | ((uint32_t)regs[i] << 8),
+                                 (uint8_t *)&value, i == 0 ? 3 : 1);
+        syslog(LOG_INFO, "CO5300: reg=%02x value=%06lx status=%d\n",
+               regs[i], (unsigned long)value, ret);
+    }
+
+    LCD_ReadMode(hlcdc, false);
+}
+
+
+/**
+  * @brief  spi read/write mode
+  * @param  enable: false - write spi mode |  true - read spi mode
+  * @retval None
+  */
+static void LCD_ReadMode(LCDC_HandleTypeDef *hlcdc, bool enable)
+{
+    if (HAL_LCDC_IS_SPI_IF(lcdc_int_cfg.lcd_itf))
+    {
+        if (enable)
+        {
+            HAL_LCDC_SetFreq(hlcdc, 2000000); //read mode min cycle 300ns
+        }
+        else
+        {
+            HAL_LCDC_SetFreq(hlcdc, lcdc_int_cfg.freq); //Restore normal frequency
+        }
+    }
+
+}
