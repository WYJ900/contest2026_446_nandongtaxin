+      return ret;
+    }
+
+  ret = ft6146_i2c_read(ft6146->i2c, FT6146_REG_ID_L, &id_l, 1);
+  if (ret < 0)
+    {
+      ierr("ft6146: read id_l failed: %d\n", ret);
+      return ret;
+    }
+
+  iinfo("ft6146 id_h=0x%02x id_l=0x%02x\n", id_h, id_l);
+  ret = work_queue(HPWORK, &ft6146->work, ft6146_data_worker, ft6146,
