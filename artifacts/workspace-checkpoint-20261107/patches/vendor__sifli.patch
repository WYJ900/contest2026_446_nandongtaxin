-  if (tmpret < 0 && errno != EEXIST)
-    {
-      serr("WARN: mkdir /proc failed: %d\n", errno);
-    }
-
-  tmpret = nx_mount(NULL, "/proc", "procfs", 0, NULL);
-  if (tmpret < 0 && tmpret != -EBUSY)
-    {
-      serr("WARN: mount procfs failed: %d\n", tmpret);
-    }
