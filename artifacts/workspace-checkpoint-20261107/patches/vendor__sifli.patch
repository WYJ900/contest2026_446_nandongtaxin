-#if defined(CONFIG_SENSORS_LSM6DSL)
-      tmpret = sf32lb52_lsm6ds3_initialize(i2c1);
-      if (tmpret < 0)
-        {
-          syslog(LOG_ERR,
-                 "ERROR: sf32lb52_lsm6ds3_initialize failed: %d\n",
