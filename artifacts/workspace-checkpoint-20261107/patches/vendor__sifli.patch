+static void LCD_Init(LCDC_HandleTypeDef *hlcdc)
+{
+#ifdef BSP_LCDC_USING_QADSPI
+    memcpy(&lcdc_int_cfg, &lcdc_int_cfg_qadspi, sizeof(lcdc_int_cfg));
+#endif /* BSP_LCDC_USING_QADSPI */
