+/* Keep the public demo GPIO numbering intact. USB detection is input-only
+ * and uses a separate node, never the shared 3V3 rail on gpio1 / PA26.
+ */
+
+static int vbus_read(struct gpio_dev_s *dev, bool *value)
+{
+  (void)dev;
+  if (value == NULL)
+    {
+      return -EINVAL;
+    }
+
+  *value = sifli_gpio_read(GET_PIN_2(hwp_gpio1, 44));
+  return OK;
+}
