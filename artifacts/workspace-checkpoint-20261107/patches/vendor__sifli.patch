-static int adc_ioctl(struct adc_dev_s *dev, int cmd, unsigned long arg)
-{
-    int ret;
-
-    (void)arg;
-
-    switch (cmd)
-    {
-        case ANIOC_TRIGGER:
-            adc_read_work(dev);
-            ret = OK;
-            break;
-
-        case ANIOC_GET_NCHANNELS:
-            ret = 1;
-            break;
-
-        case ANIOC_WDOG_UPPER:
-            ret = 1;
-            break;
-
-        case ANIOC_WDOG_LOWER:
-            ret = 1;
-            break;
-
-        default:
-            syslog(LOG_ERR, "ERROR: Unknown cmd: %d\n", cmd);
-            ret = -ENOTTY;
-            break;
-    }
-
-    return ret;
-}
