 #include <zephyr/kernel.h>
 #include <zephyr/init.h>
 #include <zephyr/device.h>
+#include <zephyr/sys/atomic.h>
+
+/*
+ * Board HCI bring-up may initialize the Zephyr compatibility layer before
+ * the Bluetooth Framework starts.  The Framework then calls z_sys_init()
+ * again while creating its local service.  Re-running SYS_INIT entries would
+ * start a second sysworkq on the same static stack, corrupting both threads.
+ *
+ * SYS_INIT is process-wide initialization, so make that contract explicit at
+ * the shared entry point instead of relying on every caller to coordinate.
+ */
+static atomic_t g_z_sys_initialized;
 
 static int do_device_init(const struct init_entry *entry)
 {
@@ -45,6 +57,10 @@ static int do_device_init(const struct init_entry *entry)
 
