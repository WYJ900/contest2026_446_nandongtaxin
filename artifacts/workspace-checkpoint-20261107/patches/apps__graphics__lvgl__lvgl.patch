+#if LV_USE_SVG
+    #include "libs/svg/lv_svg_decoder.h"
+#endif
+#if LV_USE_DRAW_VGLITE
+    #include "draw/nxp/vglite/lv_draw_vglite.h"
+#endif
+#if LV_USE_DRAW_PXP
+    #include "draw/nxp/pxp/lv_draw_pxp.h"
