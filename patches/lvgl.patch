 } lv_nuttx_lcd_t;
 
 /**********************
@@ -49,6 +51,7 @@ static int32_t align_round_up(int32_t v, uint16_t align);
 static void rounder_cb(lv_event_t * e);
 static void flush_cb(lv_display_t * disp, const lv_area_t * area_p,
                      uint8_t * color_p);
+static void flush_wait_cb(lv_display_t * disp);
 static lv_display_t * lcd_init(int fd, int hor_res, int ver_res);
 static void display_release_cb(lv_event_t * e);
 
@@ -56,6 +59,13 @@ static void display_release_cb(lv_event_t * e);
  *  STATIC VARIABLES
  **********************/
 
+#if defined(CONFIG_LV_NUTTX_LCD_STATIC_SRAM_BUFFER)
+static uint8_t g_lcd_draw_buf[CONFIG_LCD_HOR_RES_MAX *
+                              LV_NUTTX_LCD_BUFFER_SIZE * 2 *
+                              CONFIG_LV_NUTTX_LCD_PARTIAL_BUFFER_COUNT]
+                              __attribute__((aligned(64)));
+#endif
+
 /**********************
  *      MACROS
  **********************/
@@ -138,13 +148,39 @@ static void flush_cb(lv_display_t * disp, const lv_area_t * area_p,
                      uint8_t * color_p)
 {
     lv_nuttx_lcd_t * lcd = disp->driver_data;
+    lv_draw_buf_t * draw_buf = lv_display_get_buf_active(disp);
 
     lcd->area.row_start = area_p->y1;
     lcd->area.row_end = area_p->y2;
     lcd->area.col_start = area_p->x1;
     lcd->area.col_end = area_p->x2;
+    lcd->area.stride = draw_buf != NULL ? draw_buf->header.stride : 0;
     lcd->area.data = (uint8_t *)color_p;
-    ioctl(lcd->fd, LCDDEVIO_PUTAREA, (unsigned long) & (lcd->area));
+    if(ioctl(lcd->fd, LCDDEVIO_PUTAREA_ASYNC,
+             (unsigned long)&lcd->area) == 0) {
+        lcd->async_pending = true;
+        return;
+    }
+
+    ioctl(lcd->fd, LCDDEVIO_PUTAREA, (unsigned long)&lcd->area);
+    lcd->async_pending = false;
+    lv_display_flush_ready(disp);
+}
+
+static void flush_wait_cb(lv_display_t * disp)
+{
+    lv_nuttx_lcd_t * lcd = disp->driver_data;
+
+    if(!lcd->async_pending) {
+        return;
+    }
+
+    if(ioctl(lcd->fd, LCDDEVIO_WAITAREA, 200) < 0) {
+        LV_LOG_ERROR("asynchronous LCD transfer failed");
+        return;
+    }
+
+    lcd->async_pending = false;
     lv_display_flush_ready(disp);
 }
 
@@ -174,12 +210,45 @@ static lv_display_t * lcd_init(int fd, int hor_res, int ver_res)
     lv_display_render_mode_t render_mode = LV_DISPLAY_RENDER_MODE_PARTIAL;
 #endif
 
+#if defined(CONFIG_LV_NUTTX_LCD_STATIC_SRAM_BUFFER)
+    if(render_mode != LV_DISPLAY_RENDER_MODE_PARTIAL ||
+       px_size != 2 || hor_res > CONFIG_LCD_HOR_RES_MAX ||
+       buf_size > sizeof(g_lcd_draw_buf)) {
+        LV_LOG_ERROR("static LCD buffer incompatible: %dx%d, px=%" LV_PRIu32
+                     ", need=%" LV_PRIu32 ", have=%zu",
+                     hor_res, ver_res, px_size, buf_size,
+                     sizeof(g_lcd_draw_buf));
+        lv_free(lcd);
+        lv_display_delete(disp);
+        return NULL;
+    }
+
+    draw_buf = (lv_color_t *)g_lcd_draw_buf;
+#if CONFIG_LV_NUTTX_LCD_PARTIAL_BUFFER_COUNT == 2
+    draw_buf_2 = (lv_color_t *)(g_lcd_draw_buf + buf_size);
+#endif
+    lcd->draw_buf_dynamic = false;
+#else
     draw_buf = lv_malloc(buf_size);
     if(draw_buf == NULL) {
         LV_LOG_ERROR("display draw_buf malloc failed");
         lv_free(lcd);
         return NULL;
     }
+    lcd->draw_buf_dynamic = true;
+#endif
+
+#if !defined(CONFIG_LV_NUTTX_LCD_STATIC_SRAM_BUFFER) && \
+    CONFIG_LV_NUTTX_LCD_PARTIAL_BUFFER_COUNT == 2
+    draw_buf_2 = lv_malloc(buf_size);
+    if(draw_buf_2 == NULL) {
+        LV_LOG_ERROR("display partial draw_buf_2 malloc failed");
+        lv_free(draw_buf);
+        lv_free(lcd);
+        lv_display_delete(disp);
+        return NULL;
+    }
+#endif
 
 #if LV_NUTTX_LCD_BUFFER_COUNT == 2
     draw_buf_2 = lv_malloc(buf_size);
@@ -199,6 +268,7 @@ static lv_display_t * lcd_init(int fd, int hor_res, int ver_res)
     lcd->disp = disp;
     lv_display_set_buffers(lcd->disp, draw_buf, draw_buf_2, buf_size, render_mode);
     lv_display_set_flush_cb(lcd->disp, flush_cb);
