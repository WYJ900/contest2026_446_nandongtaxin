     lv_display_add_event_cb(lcd->disp, display_release_cb, LV_EVENT_DELETE, lcd->disp);
     lv_display_set_driver_data(lcd->disp, lcd);
@@ -213,17 +283,21 @@ static void display_release_cb(lv_event_t * e)
