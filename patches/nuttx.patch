diff --git a/drivers/timers/arch_timer.c b/drivers/timers/arch_timer.c
index eea3c8d6d05..d4426ccf649 100644
--- a/drivers/timers/arch_timer.c
+++ b/drivers/timers/arch_timer.c
@@ -106,7 +106,13 @@ static uint64_t current_usec(void)
     }
   while (timebase != g_timer.timebase);
 
-  return TICK2USEC(timebase) + (status.timeout - status.timeleft);
+  /* Promote before multiplying. With 32-bit clock_t, the intermediate
+   * microsecond count otherwise wraps after about 71 minutes even though
+   * the tick counter itself still has ample range.
+   */
+
+  return TICK2USEC((uint64_t)timebase) +
+         (status.timeout - status.timeleft);
 }
 
 static void udelay_accurate(useconds_t microseconds)
@@ -281,8 +287,14 @@ int weak_function up_timer_gettime(struct timespec *ts)
 
   if (g_timer.lower != NULL)
     {
-      ts->tv_sec  = current_usec() / USEC_PER_SEC;
-      ts->tv_nsec = (current_usec() % USEC_PER_SEC) * NSEC_PER_USEC;
+      uint64_t usec = current_usec();
+
+      /* Use one sample so a second boundary cannot mix an old second
+       * with the fractional part of the following second.
+       */
+
+      ts->tv_sec  = usec / USEC_PER_SEC;
+      ts->tv_nsec = (usec % USEC_PER_SEC) * NSEC_PER_USEC;
       ret = OK;
     }
 
