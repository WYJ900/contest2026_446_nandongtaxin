diff --git a/drivers/mtd/mtd_config_nvs.c b/drivers/mtd/mtd_config_nvs.c
index 60ee18982d8..41c03a56397 100644
--- a/drivers/mtd/mtd_config_nvs.c
+++ b/drivers/mtd/mtd_config_nvs.c
@@ -1612,7 +1612,14 @@ static int nvs_startup(FAR struct nvs_fs *fs)
                 last_ate->offset);
 
 #if CONFIG_MTD_CONFIG_CACHE_SIZE > 0
-          fs->cache[nvs_cache_index(last_ate->id)] = last_addr;
+          /* Recovery walks newest to oldest.  Keep the first address in
+           * each cache bucket; an older entry must not replace it.
+           */
+
+          if (fs->cache[nvs_cache_index(last_ate->id)] == NVS_CACHE_NO_ADDR)
+            {
+              fs->cache[nvs_cache_index(last_ate->id)] = last_addr;
+            }
 #endif
           while (1)
             {
@@ -1623,12 +1630,23 @@ static int nvs_startup(FAR struct nvs_fs *fs)
                   return rc;
                 }
 
-              if (nvs_ate_valid(fs, second_ate)
-                  && !nvs_ate_expired(fs, second_ate))
-                {
 #if CONFIG_MTD_CONFIG_CACHE_SIZE > 0
+              /* Cache tombstones too so a deleted key cannot be revived
+               * by an older surviving entry after interrupted writes.
+               */
+
+              if (nvs_ate_valid(fs, second_ate) &&
+                  second_ate->id != nvs_special_ate_id(fs) &&
+                  fs->cache[nvs_cache_index(second_ate->id)] ==
+                    NVS_CACHE_NO_ADDR)
+                {
                   fs->cache[nvs_cache_index(second_ate->id)] = second_addr;
+                }
 #endif
+
+              if (nvs_ate_valid(fs, second_ate)
+                  && !nvs_ate_expired(fs, second_ate))
+                {
                   if (second_ate->id == last_ate->id)
                     {
                       finfo("same id at 0x%" PRIx32 ", key_len %" PRIu16 ", "
@@ -2502,7 +2520,13 @@ int mtdconfig_register_by_path(FAR struct mtd_dev_s *mtd,
   FAR struct nvs_fs *fs;
   int rc;
 
-  fs = kmm_malloc(sizeof(struct nvs_fs));
+  /* poll state (`fds`/`events`) and cache bookkeeping must start at zero.
+   * The first successful write calls mtdconfig_notify(); an uninitialized
+   * `fds` pointer from kmm_malloc is otherwise passed to poll_notify and can
+   * hard-fault even though the flash write itself completed successfully.
+   */
+
+  fs = kmm_zalloc(sizeof(struct nvs_fs));
   if (fs == NULL)
     {
       return -ENOMEM;
