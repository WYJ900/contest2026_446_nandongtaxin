+static int sf32lb_lcd_ioctl(FAR struct lcd_dev_s *dev, int cmd,
+                            unsigned long arg)
+{
+  FAR struct sf32lb_lcd_dev_s *priv =
+    (FAR struct sf32lb_lcd_dev_s *)dev;
+
+  if (cmd == LCDDEVIO_GETBRIGHTNESS)
+    {
+      return priv->brightness;
+    }
+
+  if (cmd == LCDDEVIO_SETBRIGHTNESS)
+    {
+#ifdef CONFIG_LCD_USING_CO5300
+      int ret;
+
+      if (arg < 20 || arg > 80)
+        {
+          return -EINVAL;
+        }
+
+      ret = sf32lb_lcd_wait_xfer(priv, 200);
+      if (ret >= 0)
+        {
+          ret = co5300_set_brightness(&priv->hlcdc, (uint8_t)arg);
+        }
+
+      if (ret == 0)
+        {
+          priv->brightness = arg;
+        }
+
+      return ret;
+#else
+      return -ENOTTY;
+#endif
+    }
+
+  if (cmd == LCDDEVIO_REINITIALIZE || cmd == LCDDEVIO_DUMPSTATE ||
+      cmd == LCDDEVIO_CHECKSTATE)
+    {
+      int ret = sf32lb_lcd_wait_xfer(priv, 200);
+
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (cmd == LCDDEVIO_CHECKSTATE)
+        {
+#ifdef CONFIG_LCD_USING_CO5300
+          return priv->power > 0 ? co5300_check_state(&priv->hlcdc) : 0;
+#else
+          return -ENOTTY;
+#endif
+        }
+
+      if (cmd == LCDDEVIO_REINITIALIZE)
+        {
+          if (priv->p_drv_ops == NULL || priv->p_drv_ops->p_ops == NULL ||
+              priv->p_drv_ops->p_ops->Init == NULL)
+            {
+              return -ENODEV;
+            }
+
+          /* The application invokes this from its drawing thread between
+           * frames. Drain the previous transfer before resetting the bus.
+           */
+
+          s_lcd_hw_ready = false;
+          BSP_LCD_PowerDown();
+          usleep(100000);
+          BSP_LCD_PowerUp();
+          priv->power = 0;
+          priv->p_drv_ops->p_ops->Init(&priv->hlcdc);
+          HAL_LCDC_SetBgColor(&priv->hlcdc, 0, 0, 0);
+          HAL_LCDC_LayerReset(&priv->hlcdc, HAL_LCDC_LAYER_DEFAULT);
+          HAL_LCDC_LayerSetFormat(&priv->hlcdc, HAL_LCDC_LAYER_DEFAULT,
+                                  LCDC_PIXEL_FORMAT_RGB565);
+          s_lcd_hw_ready = true;
+          sf32lb_lcd_ensure_display_on(priv);
+#ifdef CONFIG_LCD_USING_CO5300
+          ret = co5300_set_brightness(&priv->hlcdc, priv->brightness);
+          if (ret < 0)
+            {
+              return ret;
+            }
+
+          ret = co5300_check_state(&priv->hlcdc);
+          if (ret != 0)
+            {
+              return ret < 0 ? ret : -EIO;
+            }
+#endif
+          priv->recovery_count++;
+        }
+
+#ifdef CONFIG_LCD_USING_CO5300
+      co5300_dump_state(&priv->hlcdc);
+#endif
+      syslog(LOG_INFO, "VELARIDE_LCD: state=%d error=%lu sent=%lu done=%lu"
+             " recoveries=%lu\n",
+             priv->hlcdc.State, (unsigned long)priv->hlcdc.ErrorCode,
+             (unsigned long)priv->hlcdc.debug_cnt0,
+             (unsigned long)priv->hlcdc.debug_cnt1,
+             (unsigned long)priv->recovery_count);
+      return OK;
+    }
+
+  if (cmd == LCDDEVIO_PUTAREA_ASYNC)
+    {
+      FAR struct lcddev_area_s *area = (FAR struct lcddev_area_s *)arg;
+      size_t row_bytes;
+
+      if (area == NULL || priv->bpp != 16)
+        {
+          return -EINVAL;
+        }
+
+      row_bytes = (size_t)(area->col_end - area->col_start + 1) * 2;
+      if ((size_t)area->stride != row_bytes)
+        {
+          return -ENOTSUP;
+        }
+
+      sf32lb_lcd_setarea(priv, area->col_start, area->row_start,
+                         area->col_end, area->row_end);
+      return sf32lb_lcd_start_xfer(priv, area->data,
+                                   area->col_start, area->row_start,
+                                   area->col_end, area->row_end);
+    }
+
+  if (cmd == LCDDEVIO_WAITAREA)
+    {
+      return sf32lb_lcd_wait_xfer(priv, arg > 0 ? (unsigned int)arg : 200);
+    }
+
+  return -ENOTTY;
+}
