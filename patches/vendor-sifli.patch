+        uint32_t value = 0;
+        HAL_StatusTypeDef ret;
+
+        ret = HAL_LCDC_ReadU32Reg(hlcdc,
+                                 (0x03u << 24) | ((uint32_t)regs[i] << 8),
+                                 (uint8_t *)&value, i == 0 ? 3 : 1);
+        syslog(LOG_INFO, "CO5300: reg=%02x value=%06lx status=%d\n",
