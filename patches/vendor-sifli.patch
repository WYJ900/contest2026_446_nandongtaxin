+static int sf32lb_lcd_ioctl(FAR struct lcd_dev_s *dev, int cmd,
+                            unsigned long arg)
+{
+  FAR struct sf32lb_lcd_dev_s *priv =
+    (FAR struct sf32lb_lcd_dev_s *)dev;
+
+  if (cmd == LCDDEVIO_PUTAREA_ASYNC)
+    {
+      FAR struct lcddev_area_s *area = (FAR struct lcddev_area_s *)arg;
+      size_t row_bytes;
+
+      if (area == NULL || priv->bpp != 16)
+        {
+          return -EINVAL;
+        }
+
+      row_bytes = (size_t)(area->col_end - area->col_start + 1) * 2;
+      if ((size_t)area->stride != row_bytes)
+        {
+          return -ENOTSUP;
+        }
+
+      sf32lb_lcd_setarea(priv, area->col_start, area->row_start,
+                         area->col_end, area->row_end);
+      return sf32lb_lcd_start_xfer(priv, area->data,
+                                   area->col_start, area->row_start,
+                                   area->col_end, area->row_end);
+    }
+
+  if (cmd == LCDDEVIO_WAITAREA)
+    {
+      return sf32lb_lcd_wait_xfer(priv, arg > 0 ? (unsigned int)arg : 200);
+    }
+
+  return -ENOTTY;
